# ---------------------------------------------------------------------------
# icone — environment template
# Copy to `.env` and fill in real values. Keep the same keys in both files.
# Never expose server-only values with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# App — used by the browser, redirects and crawler files.
# Localhost for development; Vercel sets https://icone-uz.vercel.app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Appwrite (server only)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=icone
APPWRITE_API_KEY=replace-with-a-server-api-key
APPWRITE_DATABASE_ID=database
APPWRITE_BUCKET_ID=bucket

# Appwrite (public, safe to expose)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=icone

# Telegram bot
# Sign-in happens in the Mini App; no /setdomain or widget domain needed.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=icone_app_bot
TELEGRAM_BOT_TOKEN=replace-with-the-bot-token
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# Cron — set to the same value as TELEGRAM_WEBHOOK_SECRET on Vercel
CRON_SECRET=replace-with-the-same-random-secret

# Build/health-check version label
NEXT_PUBLIC_APP_VERSION=1.0.0
